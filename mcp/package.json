{
  "name": "@novation/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI agent trade a Novation account inside its on-chain risk budget.",
  "type": "module",
  "bin": { "novation-mcp": "./bin/novation-mcp.mjs" },
  "scripts": {
    "start": "node bin/novation-mcp.mjs",
    "demo": "tsx scripts/demo-agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:anvil": "vitest run --project anvil"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@novation/sdk": "workspace:*",
    "tsx": "4.23.15",
    "viem": "2.57.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
