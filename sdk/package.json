{
  "name": "@novation/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed reads, writes, EIP-712 quotes and refusal decoding for the Novation clearinghouse.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./abi": "./src/abi/index.ts",
    "./calendar": "./src/calendar.ts"
  },
  "files": ["src"],
  "scripts": {
    "gen": "node scripts/gen.ts",
    "gen:check": "node scripts/gen.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:anvil": "vitest run --project anvil",
    "test:testnet": "vitest run --project testnet"
  },
  "dependencies": {
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
