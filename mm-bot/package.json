{
  "name": "@novation/mm-bot",
  "version": "0.1.0",
  "private": true,
  "description": "RFQ market maker for Novation: prices, margin-checks and signs EIP-712 quotes, served over a web-standard handler.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pricing": "./src/pricing.ts",
    "./handler": "./src/handler.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "setup:maker": "tsx --env-file-if-exists=../.env scripts/setup-maker.ts",
    "fill": "tsx --env-file-if-exists=../.env scripts/fill.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:anvil": "vitest run --project anvil"
  },
  "dependencies": {
    "@novation/sdk": "workspace:*",
    "tsx": "4.23.15",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
